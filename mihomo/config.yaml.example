# mihomo 配置示例（供 crawler 的 HTTP_PROXY=http://mihomo:7890 消费）
# 启用方式：
#   cp mihomo/config.yaml.example mihomo/config.yaml
#   # 按需编辑下方远端订阅地址（另一台机器定时更新的 clash_fast.yaml）
#   docker compose up -d --build
#   curl http://127.0.0.1:9090/proxies | jq '.proxies.PROXY.all | length'  # 应 >0
#   curl http://127.0.0.1:7890/proxies  # 同上，验证 mixed-port
# 远端订阅：https://xxx.xxx.xxx.xxx/NodeMergeClash/output/clash_fast.yaml（自建 NodeMergeClash 产出，E:\YoungYang\Git\NodeMergeClash）
# 注意：xxx.xxx.xxx.xxx 为 IP 直连 https，证书为自签；若拉取失败可改为 http 或在前端加域名/Nginx 有效证书。
# 抓取效率：PROXY 为 select（crawler 侧单页双 405 时调 mihomo 9090 API 秒级切节点），避免攒够 consecutive405 才触发熔断
# 订阅自动刷新：proxy-providers interval 控制轮询周期（默认 1800s=30分钟，crawler 另在 0 叶子时主动触发 PUT /providers/proxy/remote 刷新，见 mihomo/update-subscription.sh）

mixed-port: 7890
allow-lan: true
bind-address: "*"
mode: rule
log-level: info
ipv6: false
external-controller: "0.0.0.0:9090"
secret: ""
unified-delay: true
tcp-concurrent: true
keep-alive-interval: 30
find-process-mode: strict
profile:
  store-selected: true
  store-fake-ip: true

# 远端订阅（proxy-providers 动态拉取，自动更新）
proxy-providers:
  remote:
    type: http
    url: https://xxx.xxx.xxx.xxx/NodeMergeClash/output/clash_fast.yaml
    interval: 1800
    path: ./remote.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 60
      timeout: 5000
      expected-status: 204

proxies:

proxy-groups:
  - name: PROXY
    type: select
    use:
      - remote
    proxies:
      - auto
      - DIRECT
  - name: auto
    type: url-test
    use:
      - remote
    url: https://www.gstatic.com/generate_204
    interval: 60
    tolerance: 50

rules:
  - MATCH,PROXY
