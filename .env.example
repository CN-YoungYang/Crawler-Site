# 多站点（逗号分隔，容器内并发，每站独立定时与解析策略）
# 可选: yfbzb, ceb, demo, site2（site2 为占位，未实现时会被跳过）
SITES=yfbzb,ceb

# 全局默认（每站可用 TOTAL_PAGES_<SITE> / INTERVAL_MS_<SITE> / CRON_<SITE> 覆盖）
# 页数为硬上限；站点分页自报真实总页数更小时自动提前停止
TOTAL_PAGES=100
INTERVAL_MS=5000
MIN_DELAY_S=0
MAX_DELAY_S=300
CRON_EXPR=0 2 * * *

# 每站独立覆盖示例（可选，优先级高于全局）
# CRON_YFBZB=0 2 * * *
# CRON_CEB=0 3 * * *
# TOTAL_PAGES_CEB=30
# INTERVAL_MS_CEB=8000

# JSON 方式批量覆盖（可选，键大小写不敏感）
# SITES_CONFIG={"yfbzb":{"totalPages":100,"cron":"0 2 * * *"},"ceb":{"totalPages":30,"cron":"0 3 * * *"}}

# 时区（容器内 Date 分区依赖）
TZ=Asia/Shanghai

# 导航页 HTTP 服务（托管 file/，根 / 为总导航，/yfbzb/ /ceb/ 为各站报告）
HTTP_PORT=8080
HTTP_ENABLED=true
# 域名接入：由外部反代将 80/443 转发至 HTTP_PORT，无需改 compose

# ceb 站为风控敏感站，已内置 batchSize=1 + requestDelay 2.5-5.5s，
# 建议 INTERVAL_MS_CEB 设 8000-12000，避免被限频
