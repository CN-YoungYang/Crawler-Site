# 多站点（逗号分隔，容器内并发，每站独立定时与解析策略）
# 可选：yfbzb、ceb（注册表 sites/index.js 仅含这两站；未实现站点在 SITES 下警告后跳过，单站点下快速失败）
SITES=yfbzb,ceb

# 全局默认（每站可用 TOTAL_PAGES_<SITE> / INTERVAL_MS_<SITE> /
# MIN_DELAY_S_<SITE> / MAX_DELAY_S_<SITE> / CRON_<SITE> 覆盖）
# 页数为硬上限；站点分页自报真实总页数更小时自动提前停止
TOTAL_PAGES=100
INTERVAL_MS=5000
MIN_DELAY_S=0
MAX_DELAY_S=300
CRON_EXPR=0 2 * * *

# CEB 风控敏感：历史 Excel 观测到湖北 category 88 每日新增约 1-2 页。
# 每小时 100 页只会反复探测已被封的出口；默认每天两次、20 页上限。
# 站点分页自报总页数更小时仍会自动提前停止，20 只是安全上限。
CRON_CEB=35 3,15 * * *
TOTAL_PAGES_CEB=20
INTERVAL_MS_CEB=10000

# 每站独立覆盖示例（可选，优先级高于全局）
# CRON_YFBZB=0 2 * * *

# JSON 方式批量覆盖（可选，键大小写不敏感）
# SITES_CONFIG={"yfbzb":{"totalPages":100,"cron":"0 2 * * *"},"ceb":{"totalPages":20,"cron":"35 3,15 * * *"}}

# 时区（容器内 Date 分区依赖）
TZ=Asia/Shanghai

# 导航页 HTTP 服务（托管 file/，根 / 为总导航，/yfbzb/ /ceb/ 为各站报告）
HTTP_PORT=8080
HTTP_ENABLED=true
# 域名接入：由外部反代将 80/443 转发至 HTTP_PORT，无需改 compose

# ceb 站为风控敏感站，已内置 batchSize=1 + requestDelay 2.5-5.5s，
# 建议 INTERVAL_MS_CEB 设 8000-12000，避免被限频

# easy_proxies（docker compose 中的多端口代理池）
# 首次启动前复制 easy_proxies/config.yaml.example 为 easy_proxies/config.yaml，填写订阅地址。
CEB_PROXY_URL=http://easy_proxies:24000
EASY_PROXIES_CONTROLLER=http://easy_proxies:9091
# 管理 API 默认不设密码；若 config.yaml 设置了 management.password，在此填写相同密码。
# EASY_PROXIES_PASSWORD=
# 405 节点冷却默认 12 小时；CEB 实测封禁曾持续 >8h53m，可调到 24 小时
# EASY_PROXIES_NODE_COOLDOWN_MS=86400000
# EASY_PROXIES_REFRESH_COOLDOWN=600
# 订阅刷新接口是同步等待（拉订阅 + 健康检查），独立超时，默认 60 秒
# EASY_PROXIES_REFRESH_TIMEOUT=60
# 刷新返回后等节点池探测收敛的最长秒数，默认 20；池子稳定时只多花一两秒，设 0 关闭
# EASY_PROXIES_SETTLE_TIMEOUT=20

# --- 不使用代理由此关闭（本地无 easy_proxies 时必做）---
# 注意：docker-compose.yml 对 CEB_PROXY_URL 有 `:-http://easy_proxies:24000` 兜底，
# 仅「不写」无效，必须显式清空为空字符串；同时注释掉 Compose 的 easy_proxies 服务
# 与 crawler.depends_on。详见 DEPLOY.md 第 0 节与 3.3 节。
# 清空后 crawler 直连，日志中的 proxy_pool_empty / management unavailable 属预期降级，无需排查。
# CEB_PROXY_URL=
# PROXY_CEB=
# EASY_PROXIES_CONTROLLER=
